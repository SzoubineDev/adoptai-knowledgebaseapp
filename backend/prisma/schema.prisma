// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model AliasApplication {
  idAlias       Int     @id @default(autoincrement()) @map("id_alias")
  nomSource     String  @map("nom_source")
  systemeSource String? @map("systeme_source")
  idApplication Int     @map("id_application")
  application   Application @relation(fields: [idApplication], references: [idApplication])

  @@map("alias_application")
}

model Appareil {
  idAppareil        Int     @id @default(autoincrement()) @map("id_appareil")
  hardwareModel     String? @map("hardware_model")
  serialNumber      String? @map("serial_number")
  osVersion         String? @map("os_version")
  storageCapacityGb Int?    @map("storage_capacity_gb")
  mdmStatus         String? @default("Managed") @map("mdm_status")
  idUtilisateur     Int     @map("id_utilisateur")
  idResponsable     Int?    @map("id_responsable")
  utilisateur       Utilisateur @relation(fields: [idUtilisateur], references: [idUtilisateur])
  responsable       ResponsableIt? @relation(fields: [idResponsable], references: [idResponsable])
  installations     Installation[]

  @@map("appareil")
}

model Application {
  idApplication      Int      @id @default(autoincrement()) @map("id_application")
  nomCanonique       String   @map("nom_canonique")
  description        String?
  type               String?
  criticite          String?
  statut             String?  @default("Actif")
  dateDerniereMaj    DateTime? @map("date_derniere_maj")
  idDepartement      Int      @map("id_departement")
  departement        Departement @relation(fields: [idDepartement], references: [idDepartement])
  aliasApplications  AliasApplication[]
  installations      Installation[]
  tickets            TicketHelpdesk[]
  services           ServiceSap[]

  @@map("application")
}

model Departement {
  idDepartement    Int      @id @default(autoincrement()) @map("id_departement")
  nomDepartement   String   @map("nom_departement")
  applications     Application[]
  utilisateurs     Utilisateur[]
  tickets          TicketHelpdesk[]
  services         ServiceSap[]

  @@map("departement")
}

model Installation {
  idAppareil    Int       @map("id_appareil")
  idApplication Int       @map("id_application")
  appareil      Appareil  @relation(fields: [idAppareil], references: [idAppareil])
  application   Application @relation(fields: [idApplication], references: [idApplication])

  @@id([idAppareil, idApplication])
  @@map("installation")
}

model ModuleSap {
  idModule   Int        @id @default(autoincrement()) @map("id_module")
  nomModule  String     @map("nom_module")
  services   ServiceSap[]

  @@map("module_sap")
}

model ProcessusMetier {
  idProcessus   Int        @id @default(autoincrement()) @map("id_processus")
  nomProcessus  String     @map("nom_processus")
  services      ServiceSap[]

  @@map("processus_metier")
}

model ResponsableIt {
  idResponsable  Int      @id @default(autoincrement()) @map("id_responsable")
  nomResponsable String   @map("nom_responsable")
  idAuth         String?  @map("id_auth") @db.Uuid
  appareils      Appareil[]

  @@map("responsable_it")
}

model Serveur {
  idServeur     Int        @id @default(autoincrement()) @map("id_serveur")
  environnement String?
  nomNoeud      String?    @map("nom_noeud")
  services      ServiceSap[]

  @@map("serveur")
}

model ServiceSap {
  idServiceSap     Int     @id @default(autoincrement()) @map("id_service_sap")
  nomService       String  @map("nom_service")
  version          String?
  idApplication    Int?    @map("id_application")
  idProcessus      Int     @map("id_processus")
  idServeur        Int     @map("id_serveur")
  idDepartement    Int     @map("id_departement")
  idModule         Int     @map("id_module")
  numeroWorkflow   String? @map("numero_workflow")
  application      Application? @relation(fields: [idApplication], references: [idApplication])
  processusMetier  ProcessusMetier @relation(fields: [idProcessus], references: [idProcessus])
  serveur          Serveur @relation(fields: [idServeur], references: [idServeur])
  departement      Departement @relation(fields: [idDepartement], references: [idDepartement])
  moduleSap        ModuleSap @relation(fields: [idModule], references: [idModule])

  @@map("service_sap")
}

model TicketHelpdesk {
  idTicket        Int      @id @default(autoincrement()) @map("id_ticket")
  description     String?
  priorite        String?
  statut          String?  @default("En attente")
  dateCreation    DateTime? @map("date_creation")
  idApplication   Int      @map("id_application")
  idDepartement   Int      @map("id_departement")
  idTypeIncident  Int      @map("id_type_incident")
  application     Application @relation(fields: [idApplication], references: [idApplication])
  departement     Departement @relation(fields: [idDepartement], references: [idDepartement])
  typeIncident    TypeIncident @relation(fields: [idTypeIncident], references: [idTypeIncident])

  @@map("ticket_helpdesk")
}

model TypeIncident {
  idTypeIncident Int          @id @default(autoincrement()) @map("id_type_incident")
  libelleType    String       @map("libelle_type")
  tickets        TicketHelpdesk[]

  @@map("type_incident")
}

model Utilisateur {
  idUtilisateur Int      @id @default(autoincrement()) @map("id_utilisateur")
  email         String
  idDepartement Int      @map("id_departement")
  idAuth        String?  @map("id_auth") @db.Uuid
  departement   Departement @relation(fields: [idDepartement], references: [idDepartement])
  appareils     Appareil[]

  @@map("utilisateur")
}

// =============================================================================
// AUTH MODULE — Oussama (Feature Auth)
// =============================================================================
// The User model below is the authentication identity store.
// It is intentionally SEPARATE from the legacy `Utilisateur` model above,
// which belongs to the inventory/ITSM schema and must not be altered.
//
// RBAC: The `role` field uses RoleEnum to gate access in future middleware.
//       Hierarchy (highest → lowest): ADMINISTRATEUR > RESPONSABLE_IT
//                                   > AGENT_HELPDESK > UTILISATEUR
// =============================================================================

/// Enum describing the user's role for Role-Based Access Control (RBAC).
/// Must stay in sync with the RoleEnum in app/schemas/user.py.
enum RoleEnum {
  ADMINISTRATEUR
  RESPONSABLE_IT
  AGENT_HELPDESK
  UTILISATEUR

  @@map("role_enum")
}

/// Authentication identity for the AdoptAI knowledge-base application.
/// Stores credentials and profile data — never exposes hashed_password via API.
model User {
  /// Surrogate primary key — auto-incremented integer.
  id              Int       @id @default(autoincrement())

  /// Unique email address used as the login identifier.
  /// Indexed automatically by Prisma via `@unique`.
  email           String    @unique

  /// bcrypt hash of the user's password.
  /// The plain-text password is NEVER stored. Hashing is done in core/security.py.
  hashedPassword  String    @map("hashed_password")

  /// User's family name.
  nom             String

  /// User's given name.
  prenom          String

  /// Role for RBAC. Defaults to UTILISATEUR (least-privileged role).
  role            RoleEnum  @default(UTILISATEUR)

  /// Whether the account is active. Inactive users cannot log in.
  /// Defaults to true so newly registered users are immediately active.
  isActive        Boolean   @default(true) @map("is_active")

  /// Timestamp of account creation. Set automatically by the database.
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("user")
}
