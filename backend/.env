# ============================================================
#   AdoptAI - App Knowledge Base :: Environment Configuration
#   Copy this file to `.env` and fill in your actual values.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME="AdoptAI App Knowledge Base"
APP_VERSION="0.1.0"
APP_DESCRIPTION="Centralized knowledge base API for AdoptAI applications"
DEBUG=True
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ----------------------------------------------------------
# PostgreSQL Database (Supabase)
# For SQLAlchemy (FastAPI): postgresql+psycopg2://...
# For Prisma: postgresql://...
# SSL Mode: require for Supabase
# ----------------------------------------------------------
DATABASE_URL="postgresql+psycopg2://postgres:zoubine2004@db.yfahcnwmgwbwhrppdbcm.supabase.co:5432/postgres?sslmode=require"
PRISMA_DATABASE_URL="postgresql://postgres:zoubine2004@db.yfahcnwmgwbwhrppdbcm.supabase.co:5432/postgres?sslmode=require"

# ----------------------------------------------------------
# Security (for future auth stages)
# ----------------------------------------------------------
SECRET_KEY="change-me-to-a-long-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
