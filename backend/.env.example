# ============================================================
#   AdoptAI - App Knowledge Base :: Environment Configuration
#   Copy this file to `.env` and fill in your actual values.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
PROJECT_NAME="AdoptAI App Knowledge Base"
APP_VERSION="0.1.0"
APP_DESCRIPTION="Centralized knowledge base API for AdoptAI applications"
API_V1_STR="/api/v1"
DEBUG=True

# Allowed origins for CORS (comma-separated list)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ----------------------------------------------------------
# PostgreSQL Database (SQLAlchemy / psycopg2 — synchronous)
# Format: postgresql+psycopg2://user:password@host:port/dbname
# ----------------------------------------------------------
DATABASE_URL="postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres?sslmode=require"

# ----------------------------------------------------------
# Prisma (separate URL used by `prisma generate` / Prisma Client Python)
# Format: postgresql://user:password@host:port/dbname
# ----------------------------------------------------------
PRISMA_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres?sslmode=require"

# ----------------------------------------------------------
# Security — JWT & Password Hashing (Feature Auth — Oussama)
# Generate a strong SECRET_KEY with: openssl rand -hex 32
# ----------------------------------------------------------
SECRET_KEY="change-me-to-a-long-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
